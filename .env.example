# Copy to .env and fill in. Nothing here is required to run the board.
#
# The names live in version control; the values never do. `.env` itself is
# ignored, and this file exists so a new machine knows what to set without
# anybody having to remember.

# Reading GitHub issues onto the board (`gorilla import`). A classic
# personal access token or a fine-grained one with read access to issues.
# Only the import command reads it, and only when you run it.
GORILLA_GITHUB_TOKEN=

# What the board runs when a queue halts overnight. Anything your shell can
# run: notify-send, terminal-notifier, a curl to a webhook.
GORILLA_NOTIFY=

# Where the board posts card and halt events, if anywhere. http or https.
GORILLA_WEBHOOK=

# Agents allowed to run at once across every board on this machine.
# Defaults to 4.
GORILLA_MAX_AGENTS=

# Model extraction. Unset means the Claude Code CLI on your existing quota,
# which is what you want. `off` disables it. `api` bills a separate
# ANTHROPIC_API_KEY and exists only for people who deliberately want that.
GORILLA_EXTRACTION=
